# --- Local development: a plain SQLite file (created by `npx prisma migrate dev`) ---
DATABASE_URL="file:./dev.db"

# --- Production: Turso (libSQL). When set, these take precedence over DATABASE_URL ---
# TURSO_DATABASE_URL="libsql://your-db-your-org.turso.io"
# TURSO_AUTH_TOKEN="..."

# Random string, 32+ characters. Generate with: openssl rand -base64 32
SESSION_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# First admin account, created by `npm run db:seed` (and automatically on Vercel builds)
SEED_ADMIN_EMAIL="admin@example.com"
SEED_ADMIN_PASSWORD="change-this-password"
